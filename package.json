{
  "name": "miyuneya",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "description": "Личное пространство Miyuneya",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node scripts/start.mjs --open",
    "dev": "node scripts/start.mjs --preview",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "check": "node scripts/build.mjs --check",
    "typecheck": "node tools/typecheck/node_modules/typescript/bin/tsc -p tools/typecheck/tsconfig.json",
    "diagnose": "node scripts/diagnose.mjs",
    "diagnose:full": "node scripts/diagnose.mjs --full",
    "update:prepare": "node scripts/update.mjs prepare",
    "evaluate": "node scripts/evaluate.mjs",
    "bench:chats": "node scripts/benchmark-chats.mjs"
  }
}
